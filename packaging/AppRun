#!/usr/bin/env bash
# Peluncur di dalam AppImage.
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
PYROOT="$(find "$HERE/usr/lib" -maxdepth 2 -type d -name 'python3*' 2>/dev/null | head -n 1 || true)"

if [[ -n "$PYROOT" ]]; then
  export PYTHONPATH="$PYROOT/site-packages:$PYROOT/dist-packages:${PYTHONPATH:-}"
fi

export XDG_DATA_DIRS="$HERE/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
exec "$HERE/usr/bin/islamichabits" "$@"
